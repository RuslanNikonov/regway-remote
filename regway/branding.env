# RegWay Remote — параметры брендинга.
# Файл читается scripts/apply-branding.sh. Любую переменную можно переопределить
# переменной окружения с тем же именем (так CI подставляет ключ из GitHub Secret).

# Внутреннее имя приложения: имя .app на macOS, <APP_NAME>.exe на Windows,
# каталоги конфигурации, схема ссылок <app_name_lower>://. Только [A-Za-z0-9], без пробелов:
# макОС-скрипты RustDesk подставляют его в пути без кавычек.
APP_NAME=RegWayRemote
# Человекочитаемое имя (ProductName/FileDescription Windows, CFBundleDisplayName macOS)
APP_DISPLAY_NAME="RegWay Remote"
# Префикс bundle id / каталога конфигурации (у RustDesk: com.carriez)
ORG=com.regway
BUNDLE_ID=com.regway.remote
COMPANY="RegWay"

# Домен. При REQUIRE_REAL_KEY=1 хост обязан быть ровно REGWAY_HOST (см. apply-branding.sh)
DOMAIN=regway.group
ID_SERVER=remote.regway.group
RELAY_SERVER=remote.regway.group:21117
# API: rustdesk-api (lejianwen) за nginx. Логин, heartbeat, sysinfo, audit идут сюда.
# Без завершающего '/'. При REQUIRE_REAL_KEY=1 обязан быть https:// и не example.*
API_SERVER=https://remote.regway.group
# Публичный ключ hbbs = содержимое data/id_ed25519.pub на VPS.
# В репозитории ключа нет: значение ниже заменяется секретом RS_PUB_KEY в CI
# (при REQUIRE_REAL_KEY=1 сборка без настоящего ключа падает).
KEY=REPLACE_WITH_CONTENT_OF_id_ed25519.pub

# Куда ведут ссылки «Сайт», «Скачать», «Конфиденциальность» и т.п. в UI
WEBSITE_URL=https://remote.regway.group
# Кнопка «Помощь» / Help в клиенте — не корень API (/_admin/), а страница помощи
HELP_URL=https://remote.regway.group/help/
